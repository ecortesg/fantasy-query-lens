{
  "name": "fantasy-query-lens",
  "description": "Your fantasy roster on any rankings page, and a lineup from that page’s ranks.",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "dev:edge": "wxt -b edge",
    "build:edge": "wxt build -b edge",
    "zip:edge": "wxt zip -b edge",
    "test": "vitest run",
    "verify": "pnpm compile && pnpm test",
    "fixture:trim": "node scripts/trim-fixture.mjs"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
